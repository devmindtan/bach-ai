    },
    "gold": {
      "name": "Đồng vàng",
      "sprite": "gold-coin",
      "desc": "Có tỉ lệ rơi thêm khi hạ quái. Tích lũy qua các lượt chơi."
    },
    "chest": {
      "name": "Rương báu",
      "sprite": "chest",
      "desc": "Quái tinh anh (vòng sáng vàng) rơi ra khi chết. Nhặt được thì chọn thêm 1 thẻ nâng cấp."
    },
    "essence": {
      "name": "Tinh hoa",
      "sprite": "essence-pickup",
      "desc": "Quái tinh anh (1) và boss (10) rơi ra. Nhặt được giữ lại cả khi thua; dùng để mở node cây kỹ năng."
    },
    "gold_chest": {
      "name": "Rương vàng",
      "sprite": "chest-gold",
      "desc": "Hiếm: thỉnh thoảng rương rơi ra là rương vàng. Nhặt được thì chọn liền 3 thẻ, thêm vàng và chắc chắn có một món trang bị."
    }
  },
